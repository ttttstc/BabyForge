{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "babyforge",
  "compatibility_date": "2026-08-05",
  "compatibility_flags": ["nodejs_compat"],
  "alias": {
    "@openai/agents-core/_shims": "./node_modules/@openai/agents-core/dist/shims/shims-browser.mjs",
    "@openai/agents-core/_shims/config": "./node_modules/@openai/agents-core/dist/shims/config-browser.mjs"
  },
  "pages_build_output_dir": "dist",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "babyforge",
      "database_id": "cff73234-9527-49c5-8bed-ca15bf295263",
      "migrations_dir": "./migrations"
    }
  ]
}
