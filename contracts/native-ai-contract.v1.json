{
  "contract": "babyforge.native.ai",
  "contractVersion": "1.0.0",
  "sourceOfTruth": "src/domain/naibaSkills.js",
  "statuses": [
    "idle",
    "loading",
    "sending",
    "generating",
    "success",
    "fallback",
    "tool_failed",
    "stopped",
    "offline",
    "read_only",
    "draft_pending",
    "draft_expired",
    "draft_confirmed",
    "draft_discarded"
  ],
  "attachmentPolicy": {
    "photos": "explicit-send-only",
    "photoPreview": "required-before-send",
    "reportsIncludeOriginals": false,
    "shareIncludesOriginals": false,
    "originalRetention": "request-only"
  },
  "sourcePolicy": {
    "knowledgePack": "server-provided",
    "approvedAuthorities": ["NHC", "WHO", "CDC"],
    "externalSearch": "restricted-authority-fallback",
    "deterministicRules": "server-only"
  },
  "invariants": [
    "sessions-are-continuity-not-facts",
    "missing-facts-are-not-zero",
    "safety-floor-cannot-be-lowered",
    "drafts-require-explicit-confirmation",
    "photos-are-not-implicitly-sent",
    "read-only-cannot-confirm-drafts"
  ]
}
