{
  "contract": "babyforge.harmony.candidate",
  "contractVersion": "1.0.0",
  "bundleName": "com.ni.babyforge",
  "moduleName": "entry",
  "deviceTypes": ["phone"],
  "orientation": "portrait",
  "outputDirectory": "harmony/entry/build/default/outputs/default",
  "hapPattern": "*.hap",
  "signing": {
    "requiredForInstall": true,
    "unsignedAllowedForCi": true,
    "appGallery": false
  },
  "verification": {
    "source": "verify-harmony.mjs --source-only",
    "candidate": "verify-harmony-candidate.mjs",
    "signature": "only verified when hap-sign-tool.jar is supplied",
    "device": "only verified by a connected authorized HarmonyOS device"
  }
}
